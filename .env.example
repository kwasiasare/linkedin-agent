# ─────────────────────────────────────────────────
# ANTHROPIC — Claude API (content generation)
# ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────
# LINKEDIN — OAuth 2.0 App Credentials
# Get these from: https://www.linkedin.com/developers/apps
# ─────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ─────────────────────────────────────────────────
# LINKEDIN — Access Token
# Generated via OAuth flow: run `npm run auth`
# Expires every 60 days — re-run auth to refresh
# ─────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=your_oauth_access_token

# ─────────────────────────────────────────────────
# LINKEDIN — Organization / Company Page ID
# Found in your LinkedIn Page URL:
# linkedin.com/company/[YOUR-PAGE-SLUG]
# Then get the numeric ID from Page Admin > Settings
# ─────────────────────────────────────────────────
LINKEDIN_ORGANIZATION_ID=your_numeric_org_id

# ─────────────────────────────────────────────────
# LINKEDIN — Your Personal Member URN
# Used to act as page admin when posting
# Format: urn:li:person:XXXXXXXX
# Run `npm run auth` — it will print this for you
# ─────────────────────────────────────────────────
LINKEDIN_PERSON_URN=urn:li:person:your_member_id

# ─────────────────────────────────────────────────
# AGENT CONFIG
# ─────────────────────────────────────────────────
POST_TIME_CRON=0 8 * * 1-5
ENGAGE_TIME_CRON=0 8,17 * * 1-5
TIMEZONE=America/New_York
